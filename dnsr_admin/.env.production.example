# Production Environment Variables
# IMPORTANT: Never commit this file to git!

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API Key (restrict to your production domain)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Cloud Messaging (optional)
FCM_VAPID_KEY=your_firebase_vapid_key_here

# Notes:
# - The Supabase Anon Key is designed to be public
# - Ensure Row-Level Security (RLS) is enabled in Supabase
# - Restrict Google Maps API key to your Netlify domain
# - Never use Service Role keys in frontend applications
